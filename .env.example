# Shared data across devices (D114). Copy to .env.local and fill in from
# Supabase → Project Settings → API Keys (publishable key). Without these the app works as before: data stays in this browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
